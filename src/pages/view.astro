---
import ViewLayout from '../layouts/ViewLayout.astro';
import ClearIcon from '../components/ClearIcon.astro';
import SearchIcon from '../components/SearchIcon.astro';
import { site } from '../site.config';
import { searchEngines } from '../data/view-search';
---

<ViewLayout title={`View — ${site.name}`}>
  <div class="view-page">
    <!-- 顶栏 -->
    <header class="view-topbar">
      <a href="/">← {site.name}</a>
      <div class="view-topbar__actions">
        <div id="view-weather-pill" class="view-weather-pill" hidden>
          <span id="view-weather-icon" class="view-weather-pill__icon"></span>
          <span id="view-weather-temp" class="view-weather-pill__temp">--°</span>
        </div>
        <button
          type="button"
          id="view-layout-edit"
          class="view-btn view-btn--ghost"
          aria-expanded="false"
        >
          编辑布局
        </button>
        <button
          type="button"
          id="view-theme-toggle"
          class="view-btn view-btn--ghost view-theme-toggle"
          aria-label="主题：自动"
          title="主题：自动（点击切换）"
          data-theme-mode="auto"
        >
          <span class="view-theme-toggle__icon" aria-hidden="true"></span>
        </button>
        <button
          type="button"
          id="view-bg-toggle"
          class="view-btn view-btn--ghost"
          aria-expanded="false"
          aria-controls="view-bg-panel"
        >
          换背景
        </button>
      </div>
    </header>

    <!-- 编辑模式：组件列表面板 -->
    <div id="view-layout-panel" class="view-layout-panel view-glass view-glass--strong" hidden>
      <p class="view-layout-panel__title">添加组件</p>
      <ul id="view-layout-panel-list" class="view-layout-panel__list"></ul>
    </div>

    <!-- 背景面板（弹层） -->
    <div id="view-bg-panel" class="view-bg-panel view-glass view-glass--strong view-glass--panel" hidden>
      <p class="view-bg-panel__title">换背景</p>
      <p class="view-bg-panel__lead">打开网页即可上传，选图后立刻生效，下次访问会自动恢复。</p>
      <button type="button" id="view-bg-dropzone" class="view-bg-dropzone view-glass view-glass--soft view-glass--panel view-glass--dashed">
        <span id="view-bg-dropzone-preview" class="view-bg-dropzone__preview" hidden></span>
        <span id="view-bg-dropzone-icon" class="view-bg-dropzone__icon">+</span>
        <span id="view-bg-dropzone-text" class="view-bg-dropzone__text">点击或拖入图片</span>
        <span class="view-bg-dropzone__hint">jpg / png / webp · 建议 4MB 以内</span>
      </button>
      <input id="view-bg-upload" type="file" accept="image/*" hidden />
      <div class="view-bg-custom-actions">
        <button type="button" id="view-bg-default-btn" class="view-btn view-glass view-glass--soft view-glass--pill">恢复默认</button>
        <button type="button" id="view-bg-clear-custom" class="view-btn view-glass view-glass--soft view-glass--pill" hidden>删除当前图片</button>
      </div>
      <div id="view-bg-dim-wrap" class="view-bg-dim-control" hidden>
        <label for="view-bg-dim">壁纸暗化</label>
        <input id="view-bg-dim" type="range" min="0" max="0.85" step="0.05" value="0.45" />
        <span id="view-bg-dim-value" class="view-bg-dim-value">45%</span>
      </div>
    </div>

    <!-- 主体网格：拼图布局 -->
    <main class="view-grid" id="view-grid">
      <!-- 大时钟组件 -->
      <section class="view-tile view-tile--clock" data-tile="clock" aria-label="时间">
        <div class="view-clock-inner">
          <h1 class="view-big-clock" id="view-big-clock">--:--</h1>
          <p class="view-big-date" id="view-big-date"></p>
        </div>
      </section>

      <!-- 搜索组件 -->
      <section class="view-tile view-tile--search" data-tile="search" aria-label="搜索">
        <div class="view-search-box">
          <form id="view-search-form" class="view-search-form view-glass view-glass--strong view-glass--pill" role="search">
            <input
              id="view-search-input"
              class="view-search-input"
              type="text"
              name="q"
              enterkeyhint="search"
              inputmode="search"
              autocomplete="off"
              autocapitalize="off"
              spellcheck="false"
              aria-label="搜索"
              aria-expanded="false"
              aria-controls="view-suggest"
              aria-autocomplete="list"
            />
            <button type="button" id="view-search-clear" class="view-search-clear" hidden aria-label="清空">
              <ClearIcon />
            </button>
            <button type="submit" class="view-search-submit" aria-label="搜索">
              <SearchIcon />
            </button>
          </form>
          <!-- 搜索建议弹层 -->
          <div id="view-suggest" class="view-suggest view-glass view-glass--strong view-glass--card" hidden>
            <div class="view-suggest__cols">
              <div class="view-suggest__col view-suggest__col--query">
                <p class="view-suggest__col-title">搜索</p>
                <ul id="view-suggest-query" class="view-suggest__list" role="listbox" aria-label="搜索候选"></ul>
              </div>
              <div class="view-suggest__col view-suggest__col--links">
                <p class="view-suggest__col-title">快捷链接</p>
                <ul id="view-suggest-bookmarks" class="view-suggest__list" role="listbox" aria-label="快捷链接"></ul>
              </div>
            </div>
          </div>
        </div>
        <div id="view-engines" class="view-engines" role="group" aria-label="搜索引擎">
          {
            searchEngines.map((engine) => (
              <button
                type="button"
                class="view-engine view-glass view-glass--soft view-glass--pill"
                data-engine={engine.id}
                aria-pressed={engine.default ? 'true' : 'false'}
              >
                {engine.label}
              </button>
            ))
          }
        </div>
        <p class="view-quote" id="view-quote" hidden></p>
      </section>

      <!-- 链接图标网格组件 -->
      <section class="view-tile view-tile--links" data-tile="links" aria-label="快捷链接">
        <div id="view-bookmarks" class="view-icon-grid">
          <p class="view-empty">加载中…</p>
        </div>
      </section>

      <!-- 待办组件 -->
      <section class="view-tile view-tile--todo view-glass" data-tile="todo" aria-label="待办">
        <div class="view-widget__header">
          <h3 class="view-widget__title">待办</h3>
          <button type="button" id="view-todo-add" class="view-widget__add" title="添加待办">+</button>
        </div>
        <ul id="view-todo-list" class="view-todo-list"></ul>
        <form id="view-todo-form" class="view-todo-form" hidden>
          <input id="view-todo-input" type="text" placeholder="输入后回车添加" autocomplete="off" />
        </form>
      </section>

      <!-- 记事本组件 -->
      <section class="view-tile view-tile--countdown view-glass" data-tile="countdown" aria-label="记事本">
        <div class="view-widget__header">
          <h3 class="view-widget__title">记事本</h3>
          <div class="view-notepad__actions">
            <button type="button" id="view-notepad-save" class="view-widget__add view-notepad__btn" title="保存（Ctrl/Cmd+S）">保存</button>
            <button type="button" id="view-notepad-open" class="view-widget__add view-notepad__btn" title="读取文件">读取</button>
            <button type="button" id="view-notepad-export" class="view-widget__add view-notepad__btn" title="另存为文件">另存为</button>
          </div>
        </div>
        <textarea
          id="view-notepad-content"
          class="view-notepad__content"
          placeholder="在这里写点什么…"
          spellcheck="false"
          wrap="soft"
        ></textarea>
        <input type="file" id="view-notepad-file" accept=".txt,.md,.log,text/plain,text/markdown" hidden />
      </section>

      <!-- 音乐播放器组件 -->
      <section class="view-tile view-tile--music view-glass" data-tile="music" aria-label="音乐播放器">
        <div class="view-widget__header">
          <h3 class="view-widget__title">音乐</h3>
          <label class="view-music__upload" title="添加音乐">
            <span>+</span>
            <input type="file" id="view-music-file" accept="audio/*" multiple hidden />
          </label>
        </div>
        <div class="view-music__cover" id="view-music-cover">
          <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18V5l12-2v13"/><circle cx="6" cy="18" r="3"/><circle cx="18" cy="16" r="3"/></svg>
        </div>
        <p class="view-music__title" id="view-music-title">未播放</p>
        <div class="view-music__progress">
          <span class="view-music__time" id="view-music-current">0:00</span>
          <div class="view-music__bar" id="view-music-bar">
            <div class="view-music__bar-fill" id="view-music-bar-fill"></div>
          </div>
          <span class="view-music__time" id="view-music-duration">0:00</span>
        </div>
        <div class="view-music__controls">
          <button type="button" id="view-music-prev" class="view-music__btn" title="上一首">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M6 6h2v12H6zm3.5 6l8.5 6V6z"/></svg>
          </button>
          <button type="button" id="view-music-play" class="view-music__btn view-music__btn--play" title="播放">
            <svg id="view-music-play-icon" width="24" height="24" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
          </button>
          <button type="button" id="view-music-next" class="view-music__btn" title="下一首">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M6 18l8.5-6L6 6v12zM16 6v12h2V6h-2z"/></svg>
          </button>
        </div>
        <audio id="view-music-audio"></audio>
      </section>

      <!-- IP信息组件 -->
      <section class="view-tile view-tile--ipinfo view-glass" data-tile="ipinfo" aria-label="IP信息">
        <div class="view-widget__header">
          <h3 class="view-widget__title">IP信息</h3>
          <button type="button" id="view-ipinfo-refresh" class="view-widget__add" title="刷新">↻</button>
        </div>
        <div id="view-ipinfo-content" class="view-ipinfo__content">
          <span style="font-size:0.82rem;color:var(--view-text-muted);">加载中…</span>
        </div>
      </section>

      <!-- 快捷翻译组件 -->
      <section class="view-tile view-tile--translate view-glass" data-tile="translate" aria-label="快捷翻译">
        <div class="view-widget__header">
          <h3 class="view-widget__title">翻译</h3>
        </div>
        <div class="view-translate__langs">
          <select id="view-translate-from" class="view-translate__select">
            <option value="auto">自动检测</option>
            <option value="zh-CN">中文</option>
            <option value="en">英语</option>
            <option value="ja">日语</option>
            <option value="ko">韩语</option>
          </select>
          <button type="button" id="view-translate-swap" class="view-translate__swap" title="交换语言">⇄</button>
          <select id="view-translate-to" class="view-translate__select">
            <option value="zh-CN">中文</option>
            <option value="en" selected>英语</option>
            <option value="ja">日语</option>
            <option value="ko">韩语</option>
          </select>
        </div>
        <div class="view-translate__input-wrap">
          <textarea id="view-translate-input" class="view-translate__input" placeholder="输入后自动翻译…" rows="2"></textarea>
          <button type="button" id="view-translate-input-view" class="view-translate__mini" title="查看全文">查看</button>
        </div>
        <div class="view-translate__result-wrap">
          <p id="view-translate-result" class="view-translate__result"></p>
          <div class="view-translate__result-actions">
            <button type="button" id="view-translate-copy" class="view-translate__mini" title="复制" hidden>复制</button>
            <button type="button" id="view-translate-result-view" class="view-translate__mini" title="查看全文">查看</button>
          </div>
        </div>
      </section>

      <!-- 翻译全文弹层 -->
      <div id="view-text-viewer" class="view-text-viewer" hidden>
        <div class="view-text-viewer__panel view-glass" role="dialog" aria-modal="true">
          <div class="view-text-viewer__header">
            <span id="view-text-viewer-title" class="view-text-viewer__title">查看全文</span>
            <button type="button" id="view-text-viewer-close" class="view-text-viewer__close" title="关闭">×</button>
          </div>
          <div id="view-text-viewer-body" class="view-text-viewer__body"></div>
        </div>
      </div>

      <!-- 二维码生成组件 -->
      <section class="view-tile view-tile--qrcode view-glass" data-tile="qrcode" aria-label="二维码生成">
        <div class="view-widget__header">
          <h3 class="view-widget__title">二维码</h3>
        </div>
        <input type="text" id="view-qrcode-input" class="view-qrcode__input" placeholder="输入文字或链接…" autocomplete="off" />
        <div class="view-qrcode__canvas" id="view-qrcode-canvas">
          <span style="font-size:0.8rem;color:var(--view-text-muted);">输入后生成</span>
        </div>
        <button type="button" id="view-qrcode-download" class="view-qrcode__download" hidden>下载二维码</button>
      </section>
    </main>

    <!-- 添加链接遮罩层 -->
    <div id="view-links-overlay" class="view-links-overlay" hidden></div>

    <!-- 添加链接面板（弹层） -->
    <div id="view-links-panel" class="view-links-panel view-glass view-glass--panel" hidden>
      <p class="view-links-panel__title">添加快捷链接</p>
      <form id="view-link-form" class="view-link-form" novalidate>
        <div class="view-link-form__row">
          <label class="view-link-form__label" for="view-link-title">标题</label>
          <input id="view-link-title" class="view-link-form__input" type="text" placeholder="可选，留空则用网站域名" autocomplete="off" spellcheck="false" />
        </div>
        <div class="view-link-form__row">
          <label class="view-link-form__label" for="view-link-url">网址</label>
          <input id="view-link-url" class="view-link-form__input" type="text" placeholder="https://example.com" autocomplete="off" spellcheck="false" inputmode="url" />
        </div>
        <div class="view-link-form__row">
          <span class="view-link-form__label" id="view-link-icon-label">图标</span>
          <div class="view-link-iconbox">
            <span class="view-link-iconbox__preview" aria-hidden="true">
              <img id="view-link-icon-preview" alt="" width="32" height="32" hidden />
            </span>
            <span class="view-link-iconbox__text" id="view-link-icon-text">自动捕捉网站图标</span>
            <span class="view-link-iconbox__actions">
              <button type="button" id="view-link-icon-confirm" class="view-link-action" hidden>使用此图标</button>
              <button type="button" id="view-link-icon-upload" class="view-link-action">上传图片</button>
              <button type="button" id="view-link-icon-reset" class="view-link-action" hidden>恢复自动</button>
            </span>
          </div>
          <input id="view-link-icon-file" type="file" accept="image/*" hidden />
        </div>
        <p id="view-link-error" class="view-link-form__error" role="alert" hidden></p>
        <div class="view-link-form__actions">
          <button type="button" id="view-link-cancel" class="view-btn">取消</button>
          <button type="submit" class="view-btn view-btn--accent">添加</button>
        </div>
      </form>
    </div>
  </div>
</ViewLayout>

<script>
  import '../scripts/view-page';
  import '../scripts/view-widgets';
</script>
